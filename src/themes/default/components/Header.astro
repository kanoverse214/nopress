---
import { getResolvedSiteConfig } from '@config/resolved-site';
import { themeOptions } from '@lib/theme/options';
import ThemeToggle from './ThemeToggle.astro';
import dataService from '@lib/notion/service';

// 获取解析后的站点配置
const SITE_CONFIG = await getResolvedSiteConfig();

// 获取动态菜单项
const menuItems = await dataService.getMenuItems();

// 获取 Notion Database 的标题
const dbInfo = await dataService.getDatabaseInfo();
const siteTitle = dbInfo.title || SITE_CONFIG.title;

// 深色模式关闭时不渲染切换按钮
const { darkMode = true } = themeOptions as { darkMode?: boolean };

// 内核搜索开关（SITE_ENABLE_SEARCH），关闭时不渲染搜索入口
const enableSearch = SITE_CONFIG.enableSearch;
---

<header class="notion-header">
  <div class="header-container">
    <div class="header-content">
      <!-- Logo / 站点名称 -->
      <div class="logo">
        <a href="/" class="logo-link">{siteTitle}</a>
      </div>

      <!-- 导航和主题切换 -->
      <div class="header-actions">
        <nav class="nav">
          {menuItems.map(item => (
            <a
              href={item.url}
              class="nav-link"
              target={item.isExternal ? '_blank' : undefined}
              rel={item.isExternal ? 'noopener noreferrer' : undefined}
            >
              {item.title}
              {item.isExternal && <span class="external-icon">↗</span>}
            </a>
          ))}
        </nav>
        <!-- 菜单过长时的折叠入口：默认隐藏，余量不足时由脚本启用 -->
        <div class="nav-more" hidden>
          <button class="nav-more-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-more-panel" aria-label="更多导航">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <circle cx="5" cy="12" r="1.8"></circle>
              <circle cx="12" cy="12" r="1.8"></circle>
              <circle cx="19" cy="12" r="1.8"></circle>
            </svg>
          </button>
          <div class="nav-more-panel" id="nav-more-panel" hidden></div>
        </div>
        {darkMode && <ThemeToggle />}
        {enableSearch && (
          <button class="search-trigger" type="button" aria-label="搜索" title="搜索 (Ctrl/⌘ + K)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>
</header>

<script>
  /**
   * 菜单折叠：导航区接近放满即把排不下的项按原始顺序折入二级面板。
   * 预留余量避免「刚好塞满」时的局促排布，也吸收字体渲染的宽度差异。
   *
   * 测量方式：flex 子项不会收缩到 min-content 以下（链接 nowrap），
   * header 两个子块的 offsetWidth 之和即导航区真实所需宽度（无论是否溢出），
   * 容器宽度减去它即剩余空间。脚本只在模块首次加载执行，软导航后 DOM 重建，
   * 故按 astro:page-load 重绑，AbortController 撤销上一轮监听。
   */
  let lifecycle: AbortController | null = null;

  document.addEventListener('astro:page-load', setupNavCollapse);

  function setupNavCollapse(): void {
    lifecycle?.abort();
    lifecycle = new AbortController();
    const { signal } = lifecycle;

    const container = document.querySelector<HTMLElement>('.header-content');
    const nav = document.querySelector<HTMLElement>('.nav');
    const more = document.querySelector<HTMLElement>('.nav-more');
    const trigger = more?.querySelector<HTMLButtonElement>('.nav-more-trigger');
    const panel = more?.querySelector<HTMLElement>('.nav-more-panel');
    if (!container || !nav || !more || !trigger || !panel) return;

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
    if (links.length === 0) return;

    // 预留约半个导航项的空隙
    const RESERVE_PX = 48;

    const freeSpace = (): number => {
      const used = ([...container.children] as HTMLElement[]).reduce((width, el) => width + el.offsetWidth, 0);
      return container.clientWidth - used;
    };

    const closePanel = (): void => {
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    };

    const rebalance = (): void => {
      closePanel();
      // 先全部收回 nav（links 为原始顺序，依次 append 即还原），再从尾部折入
      for (const link of links) nav.append(link);
      more.hidden = true;
      while (freeSpace() < RESERVE_PX) {
        const current = nav.querySelectorAll<HTMLAnchorElement>('a');
        const last = current[current.length - 1];
        if (!last) break; // 全部折入仍放不下（极端窄屏），放弃
        panel.prepend(last);
        more.hidden = false;
      }
    };

    trigger.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
    }, { signal });

    document.addEventListener('click', event => {
      const target = event.target as Node;
      if (more.contains(target)) {
        // 面板内链接跳转（外链新标签打开时 DOM 不重建）后主动收起
        if (panel.contains(target) && (target as HTMLElement).closest('a')) closePanel();
        return;
      }
      closePanel();
    }, { signal });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !panel.hidden) {
        closePanel();
        trigger.focus();
      }
    }, { signal });

    let resizeTimer: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(rebalance, 100);
    }, { signal });

    rebalance();
    // 字体加载完成会改变文本宽度，重新量一次
    document.fonts?.ready.then(rebalance).catch(() => {});
  }
</script>

<style>
  .notion-header {
    position: fixed;
    top: 0;
    width: 100%;
    left: 0;
    right: 0;
    z-index: 100;
    backdrop-filter: saturate(180%) blur(20px);
    transition: background-color var(--transition), border-color var(--transition);
  }

  /* 半透明效果 */
  .notion-header {
    background-color: rgba(255, 255, 255, 0.3);
    border-bottom: 1px solid var(--notion-border);
  }

  :global(.dark) .notion-header {
    background-color: rgba(25, 25, 25, 0.3);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-2xl);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 45px;
  }

  /* Logo */
  .logo {
    flex-shrink: 0;
  }

  .logo-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--notion-text-primary);
    text-decoration: none;
    border: none;
    transition: opacity var(--transition-fast);
  }

  .logo-link:hover {
    opacity: 0.7;
    border: none;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
  }

  /* 搜索入口：几何与节奏对齐 ThemeToggle（图标 20px / padding 0.5rem / radius-md） */
  .search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border: none;
    border-radius: var(--radius-md);
    background: none;
    color: rgba(55, 53, 47, 0.8);
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition);
  }

  :global(.dark) .search-trigger {
    color: rgba(255, 255, 255, 0.75);
  }

  .search-trigger:hover {
    background-color: var(--notion-bg-hover);
    color: var(--notion-text-primary);
  }

  .search-trigger:focus-visible {
    outline: 2px solid var(--notion-link);
    outline-offset: 2px;
  }

  /* Navigation */
  .nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .nav-link {
    font-size: 0.875rem;
    color: rgba(55, 53, 47, 0.8); /* 浅色模式：80% 不透明 */
    text-decoration: none;
    border: none;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    white-space: nowrap;
  }

  :global(.dark) .nav-link {
    color: rgba(255, 255, 255, 0.75); /* 深色模式：75% 不透明 */
  }

  .nav-link:hover {
    background-color: var(--notion-bg-hover);
    color: var(--notion-text-primary);
    border: none;
  }

  .external-icon {
    display: inline-block;
    margin-left: 0.25rem;
    font-size: 0.75em;
    opacity: 0.6;
  }

  /* 折叠入口：几何对齐 search-trigger（图标 20px / padding 0.5rem / radius-md） */
  .nav-more {
    position: relative;
    flex-shrink: 0;
  }

  .nav-more-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border: none;
    border-radius: var(--radius-md);
    background: none;
    color: rgba(55, 53, 47, 0.8);
    cursor: pointer;
    transition: background-color var(--transition), color var(--transition);
  }

  :global(.dark) .nav-more-trigger {
    color: rgba(255, 255, 255, 0.75);
  }

  .nav-more-trigger:hover {
    background-color: var(--notion-bg-hover);
    color: var(--notion-text-primary);
  }

  .nav-more-trigger:focus-visible {
    outline: 2px solid var(--notion-link);
    outline-offset: 2px;
  }

  /* 二级面板：fixed header 之上，右缘与触发按钮对齐 */
  .nav-more-panel {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 10rem;
    padding: var(--spacing-xs);
    background-color: var(--notion-bg-primary);
    /* --shadow-sm 首层为 1px ring，兼任描边，不另设 border */
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    z-index: 110;
  }

  /* 折入的链接脱离 flex 行布局，改为面板内的纵向列表 */
  .nav-more-panel .nav-link {
    display: block;
    padding: 6px 10px;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .header-container {
      padding: 0 var(--spacing-lg);
    }

    .header-content {
      height: 45px;
    }

    .header-actions {
      gap: var(--spacing-sm);
    }

    .nav {
      gap: var(--spacing-sm);
    }

    .nav-link {
      font-size: 0.8125rem;
      padding: 4px 6px;
    }

    .logo-link {
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 0 var(--spacing-md);
    }

    /* 在小屏幕上隐藏部分导航项或调整布局 */
    .header-actions {
      gap: var(--spacing-xs);
    }

    .nav {
      gap: var(--spacing-xs);
    }
  }
</style>
