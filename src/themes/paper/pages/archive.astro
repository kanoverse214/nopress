---
/**
 * 归档页：全书目录（按年、点线引导）+ 标签索引
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Contents from '../components/Contents.astro';
import { collectTags, getPublishedPosts, tagHref } from '../lib/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
// 索引按名称排序，形似书末索引
const indexTags = [...tags].sort((a, b) => a.name.localeCompare(b.name, 'zh-CN'));
---

<BaseLayout title="归档" description="全部文章与标签索引">
  <div class="column">
    <header class="section-head">
      <p class="section-kicker">归档</p>
      <h1 class="section-title">目录</h1>
      <p class="section-note">共 {posts.length} 篇 · {tags.length} 个标签</p>
    </header>

    {posts.length > 0 ? <Contents posts={posts} /> : <p class="empty-note">尚无文章。</p>}

    {indexTags.length > 0 && (
      <section class="tag-index" aria-labelledby="tag-index-title">
        <h2 class="tag-index-title" id="tag-index-title">索引</h2>
        <ul class="tag-index-list">
          {indexTags.map(tag => (
            <li>
              <a href={tagHref(tag.name)}>{tag.name}</a>
              <span class="tag-index-count">{tag.count}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
