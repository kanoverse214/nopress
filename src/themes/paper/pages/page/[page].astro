---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/Home.astro';
import { getResolvedSiteConfig } from '@config/resolved-site';
import type { Post } from '@lib/types';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const SITE_CONFIG = await getResolvedSiteConfig();
  const allPosts = await getPublishedPosts();
  const perPage = Math.max(1, SITE_CONFIG.postsPerPage);
  const totalPages = Math.ceil(allPosts.length / perPage);

  // 第 1 页由首页承担，从第 2 页开始生成
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        posts: allPosts.slice((page - 1) * perPage, page * perPage),
        currentPage: page,
        totalPages,
      },
    };
  });
}

interface Props {
  posts: Post[];
  currentPage: number;
  totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<BaseLayout title={`第 ${currentPage} 页`}>
  <Home posts={posts} currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
